CPA_MANAGEMENT_URL=https://cpa.example.com/v0/management
CPA_MANAGEMENT_KEY=replace-with-management-key

# Startup-only settings. Changing them requires a process/container restart.
# HOST=0.0.0.0
# PORT=8080
# DATABASE_PATH=/data/cpa-status.db

# The settings below are hot-reloaded when this file changes.
ACCOUNT_SYNC_INTERVAL_SECONDS=30
QUOTA_SYNC_INTERVAL_SECONDS=600
QUOTA_CONCURRENCY=3
QUOTA_WARNING_PERCENT=80
REQUEST_TIMEOUT_SECONDS=45
HISTORY_RETENTION_DAYS=30

# Strongly recommended when the page is reachable from the public internet.
APP_ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_TTL_HOURS=24

# Public OAuth/upload protection. These limits apply to guests and administrators.
APP_TRUST_PROXY=false
OAUTH_START_RATE_LIMIT=3
OAUTH_CALLBACK_RATE_LIMIT=6
OAUTH_STATUS_RATE_LIMIT=180
OAUTH_RATE_LIMIT_WINDOW_SECONDS=600
OAUTH_MAX_ACTIVE_FLOWS=8
OAUTH_MAX_ACTIVE_FLOWS_PER_CLIENT=2
OAUTH_STATUS_MIN_INTERVAL_SECONDS=2
UPLOAD_RATE_LIMIT=5
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=600
UPLOAD_MAX_FILE_BYTES=1048576
UPLOAD_MAX_REQUEST_BYTES=5242880
UPLOAD_MAX_FILES=5
LOGIN_RATE_LIMIT=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Comma-separated: telegram,pushplus,serverchan
NOTIFY_CHANNELS=telegram,pushplus,serverchan
# Comma-separated event keys. Use all for every event or none to disable event delivery.
NOTIFY_EVENTS=account_auth_invalid,account_disabled,account_quota_exhausted,account_rate_limited

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Optional additional Telegram bot. Keep token and chat IDs on the same suffix.
TELEGRAM_BOT_TOKEN_2=
TELEGRAM_CHAT_IDS_2=

PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=
PUSHPLUS_CHANNEL=wechat
# Optional additional PushPlus recipient.
PUSHPLUS_TOKEN_2=
PUSHPLUS_TOPIC_2=
PUSHPLUS_CHANNEL_2=wechat

# ServerChan SendKey: SCT... for Turbo, or sctp{uid}t... for ServerChan 3.
SERVERCHAN_SENDKEY=
# Optional additional ServerChan recipient.
SERVERCHAN_SENDKEY_2=

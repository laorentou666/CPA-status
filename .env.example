CPA_MANAGEMENT_URL=https://cpa.example.com/v0/management
CPA_MANAGEMENT_KEY=replace-with-management-key

# Startup-only settings. Changing them requires a process/container restart.
# HOST=0.0.0.0
# PORT=8080
# DATABASE_PATH=/data/cpa-status.db

# The settings below are hot-reloaded when this file changes.
ACCOUNT_SYNC_INTERVAL_SECONDS=30
QUOTA_SYNC_INTERVAL_SECONDS=600
QUOTA_CONCURRENCY=3
QUOTA_WARNING_PERCENT=80
REQUEST_TIMEOUT_SECONDS=45
HISTORY_RETENTION_DAYS=30

# Strongly recommended when the page is reachable from the public internet.
APP_ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_TTL_HOURS=24

# Comma-separated: telegram,pushplus,serverchan
NOTIFY_CHANNELS=telegram,pushplus,serverchan
NOTIFY_MIN_SEVERITY=warning

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Optional additional Telegram bot. Keep token and chat IDs on the same suffix.
TELEGRAM_BOT_TOKEN_2=
TELEGRAM_CHAT_IDS_2=

PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=
PUSHPLUS_CHANNEL=wechat
# Optional additional PushPlus recipient.
PUSHPLUS_TOKEN_2=
PUSHPLUS_TOPIC_2=
PUSHPLUS_CHANNEL_2=wechat

# ServerChan SendKey: SCT... for Turbo, or sctp{uid}t... for ServerChan 3.
SERVERCHAN_SENDKEY=
# Optional additional ServerChan recipient.
SERVERCHAN_SENDKEY_2=
